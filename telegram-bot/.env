# Telegram Bot Token
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin IDs (comma-separated if multiple)
ADMIN_IDS=123456789

# Plan Prices (in USD)
PLAN_BRONZE_PRICE=4.99
PLAN_SILVER_PRICE=12.99
PLAN_GOLD_PRICE=24.99

# Plan Duration (in days)
PLAN_BRONZE_DAYS=30
PLAN_SILVER_DAYS=90
PLAN_GOLD_DAYS=180

# Environment
NODE_ENV=production

# Crypto Addresses (for payment collection)
BTC_ADDRESS=your_btc_address_here
ETH_ADDRESS=your_eth_address_here
USDT_ADDRESS=your_usdt_address_here
USDC_ADDRESS=your_usdc_address_here
